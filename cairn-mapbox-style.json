{
  "version": 8,
  "name": "CAIRN Tactical Alpine 3D",
  "metadata": {
    "mapbox:autocomposite": true,
    "mapbox:type": "template",
    "description": "Tactical dark-mode 3D terrain style with hillshading, atmospheric mountain fog, and contour lines for Mapbox Studio."
  },
  "center": [8.4912, 46.49],
  "zoom": 12.2,
  "bearing": -18,
  "pitch": 55,
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "sprite": "mapbox://sprites/mapbox/dark-v11",
  "sources": {
    "mapbox-dem": {
      "type": "raster-dem",
      "url": "mapbox://mapbox.mapbox-terrain-dem-v1",
      "tileSize": 512,
      "maxzoom": 14
    },
    "composite": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v8"
    },
    "contour-data": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-terrain-v2"
    }
  },
  "terrain": {
    "source": "mapbox-dem",
    "exaggeration": 1.45
  },
  "fog": {
    "range": [0.8, 8.0],
    "color": "#0E120A",
    "horizon-blend": 0.15,
    "high-color": "#2A3320",
    "space-color": "#0C0F08",
    "star-intensity": 0.25
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0E120A"
      }
    },
    {
      "id": "hillshading",
      "type": "hillshade",
      "source": "mapbox-dem",
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "hillshade-exaggeration": 0.85,
        "hillshade-shadow-color": "#080B06",
        "hillshade-highlight-color": "#55642D",
        "hillshade-accent-color": "#252A1E",
        "hillshade-illumination-direction": 315,
        "hillshade-illumination-anchor": "viewport"
      }
    },
    {
      "id": "contour-index",
      "type": "line",
      "source": "contour-data",
      "source-layer": "contour",
      "filter": [">", "ele", 0],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#3A4030",
        "line-width": 0.75,
        "line-opacity": 0.45
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": {
        "fill-color": "#090D07",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "composite",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#151B10",
        "line-width": 1.2
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["in", "class", "path", "track"],
      "paint": {
        "line-color": "#252A1E",
        "line-width": 1,
        "line-dasharray": [2, 2],
        "line-opacity": 0.5
      }
    },
    {
      "id": "admin-country",
      "type": "line",
      "source": "composite",
      "source-layer": "admin",
      "filter": ["==", "admin_level", 2],
      "paint": {
        "line-color": "#525946",
        "line-width": 1.5,
        "line-dasharray": [4, 4],
        "line-opacity": 0.7
      }
    },
    {
      "id": "peak-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "natural_label",
      "filter": ["==", "type", "peak"],
      "layout": {
        "text-field": ["concat", ["get", "name"], " (", ["get", "elevation_m"], "m)"],
        "text-font": ["DIN Pro Bold", "Arial Unicode MS Bold"],
        "text-size": 9,
        "text-offset": [0, 1.2],
        "text-anchor": "top",
        "text-transform": "uppercase",
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#D4F53C",
        "text-halo-color": "#0E120A",
        "text-halo-width": 2
      }
    }
  ]
}
